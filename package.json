{
  "name": "dsh-agent-browser",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grant-Felix/dsh-agent-browser.git"
  },
  "private": true,
  "type": "module",
  "description": "Agent browser for DSH: a real Chrome-Linux browser driven over CDP, shown live in the right Sidebar, plus agent-facing browser tools.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ]
}
